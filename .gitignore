# ignore all .gz-files: too large for github.
*.gz
# ignore ~ files.
*~
# ignore all hidden files and folders:
.*
# Except for .gitignore and .gitmodules.
!/.gitignore
!/.gitmodules
# Ignore vcf files. 
*.vcf 
# Ignore .csv files
*.csv 
*.tree
*.txt
*.tsv 
# Except for test files.
!packages/PackageToBeShipped/test/testwithheader.csv
!packages/PackageToBeShipped/test/testwithheader.csv.gz 
!packages/PackageToBeShipped/test/testwithoutheader.csv 
!packages/PackageToBeShipped/test/testwithoutheader.csv.gz
# Ignore Manifest.toml files.
**/Manifest.toml
 